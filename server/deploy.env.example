# Copy to server/deploy.env (gitignored) and edit. Read by ../docker.sh.

# The front end's origin. Comma-separated for several; "*" allows anyone, which
# leaves this server open for others to use as their own free backend.
ALLOW_ORIGIN=https://rtl-improved.pages.dev

# Bound to loopback because the only way in is the Cloudflare Tunnel. Change
# BIND_ADDR only if cloudflared itself runs in a container and cannot reach the
# host's loopback.
PORT=8080
BIND_ADDR=127.0.0.1

# Where the SQLite database lives on the host. Defaults to server/data.
# DATA_DIR=/srv/rtld/data

# Backstops against connection exhaustion; Cloudflare handles volumetric abuse.
# MAX_PER_CLIENT is deliberately loose: Malé's carriers use CGNAT, so many real
# riders share one address and a tight cap would lock out a whole network.
MAX_CONNECTIONS=500
MAX_PER_CLIENT=20

LOG_LEVEL=info
