# Copy to server/deploy.env (gitignored) and edit. Read by ../docker.sh.

# The front end's origin. Comma-separated for several; "*" allows anyone, which
# leaves this server open for others to use as their own free backend.
ALLOW_ORIGIN=https://rtl-improved.pages.dev

# Bound to loopback because the only way in is the Cloudflare Tunnel. Change
# BIND_ADDR only if cloudflared itself runs in a container and cannot reach the
# host's loopback.
PORT=8080
BIND_ADDR=127.0.0.1

# Where the SQLite database lives on the host. A relative path is taken from the
# repo root; anything absolute is used as-is. Defaults to data.
DATA_DIR=data

# Backstops against connection exhaustion; Cloudflare handles volumetric abuse.
# MAX_PER_CLIENT is deliberately loose: Malé's carriers use CGNAT, so many real
# riders share one address and a tight cap would lock out a whole network.
MAX_CONNECTIONS=500
MAX_PER_CLIENT=20

LOG_LEVEL=info

# The public half of the SSH key allowed to call the read-only diagnostics
# endpoint at /v1/admin/rpc, as an authorized_keys line — paste the contents of
# ~/.ssh/id_rsa.pub from the machine that will be doing the diagnosing.
#
# Every request must carry a fresh SSH signature over its own body, so this is a
# public key in the ordinary sense: it authenticates, it does not authorise, and
# there is nothing here that is a secret to leak. The endpoint can read the
# database and the logs; it cannot write to either.
#
# Left empty, the route is never registered and the endpoint does not exist.
# ADMIN_PUBLIC_KEY=ssh-rsa AAAA... you@laptop
